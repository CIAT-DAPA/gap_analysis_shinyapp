fls_json <- list.files("Z:/1.Data/Palmira/CSO/data", pattern = "clim_conflict_ips_overlays.xlsx$", recursive = T, full.names = T)#"\KEN\_results\cluster_results\climate\climate_reg_cluster_values_extracted.csv"
fls_json <- fls_json[!grepl("old", fls_json)]

dic <- readxl::read_excel("Z:/1.Data/Palmira/CSO/used_variables_data_dictionary_plus_geojson.xlsx")

lst <- lapply(fls_json, function(path){
  iso <- stringr::str_extract(path, "data/[A-Z]{3}")
  iso <- base::gsub("data/", "", iso)
  
  geo_fl <- names(readxl::read_excel(path))
  
  code_clim <- gsub("climvar_", "",geo_fl[grepl("^climvar", geo_fl)] )
  
  code_ip <- gsub("^([A-Z][a-z ]+_)", "",geo_fl[grepl("^[A-Z][a-z]+", geo_fl)] )
  code_ip <- stringr::str_extract(code_ip, "[a-zA-Z0-9_ ]+_thr")
  code_ip <- gsub("_thr$", "", code_ip)
  
  to_ret <- data.frame(iso = iso, var_names = geo_fl)
  to_ret$code_var <- rep(NA, nrow(to_ret))
  to_ret$category_var <-  rep(NA, nrow(to_ret))
  
  to_ret$code_var[grepl("^climvar", to_ret$var_names) ] <- code_clim
  to_ret$code_var[grepl("^[A-Z][a-z]+", to_ret$var_names)] <- code_ip
  
  to_ret$category_var[grepl("^climvar", to_ret$var_names) ] <- "climate"
  to_ret$category_var[grepl("^[A-Z][a-z]+", to_ret$var_names)] <- "Socio-economic"
  
  dic_2 <- dic[!is.na(dic$Code),]
  
  dic_2$Code <- gsub("\\{iso\\}", iso, dic_2$Code)
  
  
  to_ret <- dplyr::left_join(to_ret,dic_2, by = c("code_var" = "Code") )
  
  return(to_ret)
  })


df_x<- do.call(rbind, lst)


