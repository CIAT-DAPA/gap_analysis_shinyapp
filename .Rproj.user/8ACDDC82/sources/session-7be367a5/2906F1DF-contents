#' bind cols varios vectores con diferente numero de elementos
#'@param lst list with variables names vectors
cbind.na <-function(lst){
  
  mxlgth <- max(sapply(lst, length))
  
  fill.na <- lapply(lst, function(i){
    to_fill <- mxlgth-length(i)
    c(i, rep(NA, to_fill))
  })
  
  to_ret <- do.call(cbind, fill.na)
  #names(to_ret) <- names()      
return(to_ret)
  }

